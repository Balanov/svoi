{
  "name": "svoi-local-career-agent",
  "version": "1.0.0",
  "description": "Свой — бесплатный локальный помощник для поиска работы и повседневных рабочих задач.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Баланов Антон Николаевич"
  },
  "homepage": "https://svoi.balanov.pro/",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && node scripts/dist-win.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.58.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "build": {
    "appId": "pro.balanov.svoi",
    "productName": "Свой",
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "executableName": "Svoi",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Свой",
      "installerLanguages": [
        "ru_RU"
      ],
      "artifactName": "Svoi-Setup-Windows-${version}-${arch}.${ext}"
    }
  }
}
